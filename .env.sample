# URL for the AI model API (e.g. http://host.docker.internal:8080/v1/chat/completions)
AI_MODEL_URL=

# Provider for the LLM (e.g. openai)
LLM_PROVIDER=

# Specific LLM model to use (e.g. default)
LLM_MODEL=

# Cloudflare Token for the secure tunnel connection
TUNNEL_TOKEN=

# Default language for the AI chatbot
DEFAULT_LANGUAGE=en

# ID of the bot user in PocketBase (for the messages collection)
BOT_USER_ID=
